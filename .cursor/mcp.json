{
  "mcpServers": {
    // Сервер для доступа к файловой системе проекта
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."  // корень проекта – можно указать абсолютный путь или относительный
      ],
      "description": "Предоставляет доступ к файлам и папкам проекта для чтения/записи через Cursor."
    },

    // Сервер для интеграции с GitHub (просмотр репозиториев, issues, PR, поиск кода)
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        // 🔑 Необходимо создать Personal Access Token с правами repo и read:org
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_ваш_токен_здесь"
      },
      "description": "Позволяет работать с GitHub: создавать issues, просматривать PR, искать код в ваших репозиториях."
    },

    // Сервер для получения документации из интернета (например, Telegram API, Flutter)
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "description": "Извлекает веб-страницы (документацию, статьи) для анализа и поиска информации."
    }
  },

  // Дополнительная настройка (опционально)
  "settings": {
    "defaultServer": "filesystem",
    "enableLogging": true
  }
}
