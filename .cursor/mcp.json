{
  "mcpServers": {
    // Сервер для доступа к файловой системе проекта
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."  // корень проекта – можно указать абсолютный путь или относительный
      ],
      "description": "Предоставляет доступ к файлам и папкам проекта для чтения/записи через Cursor."
    },

    // Сервер для получения документации из интернета (например, Telegram API, Flutter)
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "description": "Извлекает веб-страницы (документацию, статьи) для анализа и поиска информации."
    }
  },

  // Дополнительная настройка (опционально)
  "settings": {
    "defaultServer": "filesystem",
    "enableLogging": true
  }
}
