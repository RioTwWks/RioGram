# RioGram Web infrastructure (§8.4)
# Copy to /etc/riogram/web.env and fill in values.

# --- Domain (RU VPS) ---
RIOGRAM_DOMAIN=your-domain.ru
# Public HTTPS listen on RU Nginx (default 443). Use 16443 if :443 is taken.
RIOGRAM_HTTPS_PORT=443
# Browser / WSS: https://your-domain.ru  or  https://your-domain.ru:16443
#                 wss://your-domain.ru   or  wss://your-domain.ru:16443

# --- SSH reverse tunnel (EU → RU) ---
# EU connects to RU and exposes EU backend on RU localhost.
TUNNEL_SSH_USER=tunnel
TUNNEL_RU_HOST=203.0.113.10
TUNNEL_RU_PORT=8080
TUNNEL_EU_PORT=8080
# Bind tunnel on RU side to localhost only (requires GatewayPorts clientspecified on RU sshd)
TUNNEL_RU_BIND=127.0.0.1

# --- EU backend (localhost only) ---
EU_BACKEND_PORT=8080
WSS_PROXY_PORT=5001
# Static Flutter Web served by nginx from /opt/riogram/web (§8.5)

# --- Optional: restrict EU SSH to RU VPS IP ---
# EU_UFW_ALLOW_SSH_FROM=203.0.113.10

# --- Certbot (RU VPS) ---
CERTBOT_EMAIL=admin@your-domain.ru
