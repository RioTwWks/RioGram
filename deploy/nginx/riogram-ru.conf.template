# RioGram RU frontend — Nginx + WSS (§8.4)
# Install: scripts/setup-web-infra-ru.sh
# Placeholders: __RIOGRAM_DOMAIN__, __RIOGRAM_HTTPS_PORT__, __RIOGRAM_HTTPS_PORT_SUFFIX__
# Default HTTPS port is 443; use e.g. 16443 when :443 is already occupied.
# Browser URL: https://domain__RIOGRAM_HTTPS_PORT_SUFFIX__/

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream riogram_tunnel {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __RIOGRAM_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host__RIOGRAM_HTTPS_PORT_SUFFIX__$request_uri;
    }
}

server {
    # WebSocket upgrade requires HTTP/1.1 — do not enable http2 here.
    listen __RIOGRAM_HTTPS_PORT__ ssl;
    listen [::]:__RIOGRAM_HTTPS_PORT__ ssl;
    server_name __RIOGRAM_DOMAIN__;

    # Prefer: certbot certonly --webroot -w /var/www/certbot -d __RIOGRAM_DOMAIN__
    # (works with non-443 HTTPS listen). For :443 only, certbot --nginx also works.
    ssl_certificate     /etc/letsencrypt/live/__RIOGRAM_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__RIOGRAM_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://riogram_tunnel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
